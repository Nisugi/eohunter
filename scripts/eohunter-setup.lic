=begin
  eohunter-setup: hunt profile editor, rendered through Lich's WebUI.
  Start with ;eohunter setup or ;eohunter-setup. Stop with ;kill eohunter-setup.
  Saves EOHunter configuration only; it never starts a hunt.
=end

me = Script.current
exit if Script.list.any? { |other| other.name == me.name && !other.equal?(me) }

require File.join(LIB_DIR, 'webui.rb')
load File.join(SCRIPT_DIR, 'eohunter', 'setup', 'runtime.rb') unless defined?(::EO::HunterSetup::Runtime)
EO::HunterSetup::Runtime.load_support(SCRIPT_DIR)

app = EO::HunterSetup::Runtime.app(
  data_dir: DATA_DIR, game: XMLData.game, character: Char.name,
  char_settings: CharSettings.to_hash,
  templates: defined?(CreatureTemplate) ? CreatureTemplate.all : [],
  rooms: Map.list, uid_resolver: ->(uid) { Map.ids_from_uid(uid) }
)
editor = EO::HunterSetup::Editor.new(app: app)

# The page is torn down with this script, but the WebUI service is shared with
# every other script using it, so terminate_owner -- never service.stop.
before_dying { Lich::WebUI.terminate_owner(me) }

closed = Queue.new
page = nil

# Re-render after a handler changes the draft. Handlers run on the dispatcher
# thread, so this must stay cheap: mutate, refresh, return.
refresh = lambda do |changed|
  Lich::WebUI.refresh(page) if changed && page
  changed
end

handlers = {
  rename: ->(event) { refresh.call(editor.on_rename(event[:value])) },
  validate: ->(_event) { refresh.call(editor.on_validate) },
  save: ->(_event) { refresh.call(editor.on_save) },
  revert: ->(_event) { refresh.call(editor.on_revert) },
  select_page: ->(_event) { false },
  load: ->(name, _event) { refresh.call(editor.on_load(name)) },
  change: ->(key, event) { refresh.call(editor.on_change(key, event[:value])) },
  new: ->(_event) { refresh.call(editor.on_new) },
  set_active: ->(name, _event) { refresh.call(editor.on_set_active(name)) },
  set_hidden: ->(name, hidden, _event) { refresh.call(editor.on_set_hidden(name, hidden)) },
  copy_legacy: ->(name, _event) { refresh.call(editor.on_copy_legacy(name)) },
  request_delete: ->(name, _event) { refresh.call(editor.on_request_delete(name)) },
  # The dialog reports which button closed it; anything but Delete keeps the
  # document, including a dialog dismissed without a choice.
  list_set: ->(key, index, event) { refresh.call(editor.on_list_set(key, index, event[:value])) },
  list_add: ->(key, event) { refresh.call(editor.on_list_add(key, event[:value])) },
  list_remove: ->(key, index, _event) { refresh.call(editor.on_list_remove(key, index)) },
  list_move: ->(key, index, offset, _event) { refresh.call(editor.on_list_move(key, index, offset)) },
  toggle_map: ->(_event) { refresh.call(editor.on_toggle_map) },
  sheet: ->(event) { refresh.call(editor.on_sheet(event[:value])) },
  assign_role: ->(event) { refresh.call(editor.on_assign_role(event[:value])) },
  map_click: ->(event) { refresh.call(editor.on_map_click(event[:region], event[:button])) },
  delete_response: lambda { |event|
    changed = event[:button] == 'delete' ? editor.on_confirm_delete : editor.on_cancel_delete
    refresh.call(changed)
  }
}

# The map sheets are read from Lich's own MAP_DIR. register_files needs the
# directory to sit inside a registered application, script or user root, and
# script_root is caller-supplied -- so naming MAP_DIR as both the directory and
# the root is what lets an installed map serve without a Lich change.
begin
  if defined?(MAP_DIR) && File.directory?(MAP_DIR.to_s)
    EO::HunterSetup::Page.map_route =
      Lich::WebUI.service.register_files('eohunter-maps', MAP_DIR, owner: me, script_root: MAP_DIR)
  end
rescue StandardError => error
  # A map that cannot be served is not a reason to refuse the editor: every
  # other page still works, and the map says so itself.
  Lich::Messaging.msg('warn', "eohunter setup: installed maps unavailable (#{error.message})")
end

page = Lich::WebUI.page(
  owner: me, id: 'eohunter-setup', title: 'EOHunter - Hunt setup',
  props: { bare: true },
  on: { close: ->(event) { closed.push(event[:reason]) } }
) { |builder| EO::HunterSetup::Page.render(builder, editor, on: handlers) }

# The WebUI listener is one accept-loop thread, and a thread created from a
# script belongs to that script's ThreadGroup -- which Lich kills when the
# script stops. Starting the shared service from here would hand it a thread
# that dies on ;kill, taking the WebUI down for every other script. Start it
# from the default group so it outlives us.
starter = Thread.new { Lich::WebUI.start }
ThreadGroup::Default.add(starter)
starter.join

# The per-page refresh and dispatcher threads that Lich creates later do belong
# to this script, and that is right: they serve this page and should stop when
# it does. Only the shared accept loop must outlive us.

url = Lich::WebUI.launch_url(page: page)
Lich::Messaging.msg('info', "eohunter setup: #{url}")
# An app-mode window needs Chrome or Edge; without one the printed URL above
# still opens anywhere. Launch failure is not an error.
Lich::WebUI.open(page: page)

closed.pop
