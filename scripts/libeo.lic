=begin
  libeo: the shared library for the e-scripts (ebounty, eloot, eherbs, ecleanse, eohunter).

  Loaded once per session with Script.loadlib('libeo'); definitions persist after the
  library script exits. A script names the version it was built against and the library
  refuses a mismatch loudly:

    Script.loadlib('libeo')
    EO.require('0.1.0')

  What lives here is script-side glue that Lich itself should not carry: the go2 wrapper
  and visit, the help table, and the version gate. Anything that is a game rule
  or parser plumbing belongs in Lich itself (Stance, Stash.wield, Bank, Mana.pulse,
  issue_command, Spell state) and is called directly; a script that needs it raises its
  required Lich version. Nothing script-specific goes in either: eloot's Loot / Sell / Hoard, ebounty's
  Task, eherbs' stocking stay in their scripts.

        author: elanthia-online
  contributors: Nisugi
          game: Gemstone
          tags: library, utility, eo
      required: Lich >= 5.22.0
       version: 0.1.0

  Version Control:
  Major_change.feature_addition.bugfix
  v0.1.0 (2026-09-10)
    - initial: EO.require / EO.version, EO.go2 / EO.at? / EO.nearest / EO.visit,
      EO.help
=end

require 'terminal-table'

# Anchored to the root: Lich evaluates a script body inside Lich::Common, so a
# bare `module EO` here would define Lich::Common::EO, which the engine library
# and any code outside a script binding would not find.
module ::EO
  VERSION = '0.1.0'.freeze

  # The lowest version a caller may name that this library still serves. Raise it
  # when an API is removed, so a script built against the removed API fails at
  # load rather than at the call.
  OLDEST_SUPPORTED = '0.1.0'.freeze

  class VersionError < StandardError; end

  # ---------------------------------------------------------------------------
  # Version gate
  # ---------------------------------------------------------------------------

  # A script calls this right after Script.loadlib('libeo') with the libeo version
  # it was written against. Too new a request means the script is ahead of the
  # library the user has; too old means the library dropped something the script
  # may use. Both are loud.
  #
  # @param wanted [String] the version the calling script was built against
  # @return [true]
  # @raise [VersionError] on a mismatch, after telling the user how to fix it
  def self.require(wanted)
    have = Gem::Version.new(VERSION)
    want = Gem::Version.new(wanted.to_s)
    caller_name = Script.current&.name || 'script'
    if want > have
      Lich::Messaging.msg('error', "#{caller_name} needs libeo #{wanted} but #{VERSION} is installed. Update libeo (;repo download libeo or ;jinx).")
      raise VersionError, "libeo #{VERSION} is older than #{wanted} required by #{caller_name}"
    elsif want < Gem::Version.new(OLDEST_SUPPORTED)
      Lich::Messaging.msg('error', "#{caller_name} was built against libeo #{wanted}, which #{VERSION} no longer supports. Update #{caller_name}.")
      raise VersionError, "libeo #{VERSION} no longer supports #{wanted} required by #{caller_name}"
    end
    true
  end

  # @return [String] the library version
  def self.version
    VERSION
  end

  # A Terminal::Table help block in the layout every e-script uses.
  #
  #   EO.help([['setup', 'UI configuration tool'], ['load', 'Reloads all settings']])
  #
  # Each row is [command, description]; the command is prefixed with ;scriptname.
  # A row that is a String becomes a centered full-width line; :separator passes through.
  #
  # @param rows [Array<Array(String, String), String, Symbol>]
  # @param title [String, nil]
  # @return [void]
  def self.help(rows, title: nil)
    name = Script.current&.name.to_s
    table_rows = rows.map do |row|
      case row
      when Symbol then row
      when String then [{ value: row, colspan: 2, alignment: :center }]
      else
        cmd, desc = row
        cmd = cmd.to_s.empty? ? "#{$lich_char}#{name}" : "#{$lich_char}#{name} #{cmd}"
        [cmd, desc.to_s]
      end
    end
    title ||= "#{name.capitalize} ver #{Script.version(name)}"
    table = Terminal::Table.new(title: title, rows: table_rows)
    respond
    respond table
    respond
  end

  # ---------------------------------------------------------------------------
  # Travel
  # ---------------------------------------------------------------------------

  # The go2 wrapper every e-script re-implements: unhide, skip when already
  # there, warn on an unknown room, run go2 with --disable-confirm.
  #
  # @param place [Integer, String] room id, "u" uid, or a map tag such as 'bank'
  # @param force [Boolean] kill a go2 already running first (ecleanse's behaviour)
  # @param unhide [Boolean]
  # @return [Boolean] whether the current room now matches +place+
  def self.go2(place, force: false, unhide: true)
    fput('unhide') if unhide && (hidden? || invisible?)
    return true if at?(place)

    if Room.current.nil? || Room.current.id.nil?
      Lich::Messaging.msg('warn', "go2: in an unmapped room, heading for #{place}")
    end
    Script.run('go2', "#{place} --disable-confirm", { quiet: true, force: force })
    at?(place)
  end

  # @param place [Integer, String] room id, "u" uid, or a map tag
  # @return [Boolean] whether the current room is that place
  def self.at?(place)
    room = Room.current
    return false if room.nil?
    case place
    when Integer then room.id == place
    when /\A\d+\z/ then room.id == place.to_i
    when /\Au-?\d+\z/i then room.uid.to_a.map(&:to_s).include?(place[1..])
    else room.tags.include?(place.to_s)
    end
  end

  # @param tag [String]
  # @return [Integer, nil] the nearest room id carrying +tag+, avoiding FWI rooms
  #   unless the character is already on the island
  def self.nearest(tag)
    room = Room.current
    return nil if room.nil?
    candidates = room.find_all_nearest_by_tag(tag)
    candidates = candidates.reject { |id| fwi?(Room[id]) } unless fwi?(room)
    candidates.first
  end

  # @param room [Room, nil]
  # @return [Boolean] whether a room is on Four Winds Isle (Mist Harbor)
  def self.fwi?(room)
    return false if room.nil?
    room.location.to_s =~ /Mist Harbor|Four Winds/i ? true : false
  end

  # Go somewhere, do something, come back.
  #
  #   EO.visit('bank') { Lich::Gemstone::Bank.deposit }
  #
  # @param place [Integer, String] a room id or a map tag; a tag resolves to the
  #   nearest room carrying it, avoiding Four Winds Isle unless already there
  # @return [Object, nil] the block's value, nil when the place could not be reached
  def self.visit(place)
    here = Room.current&.id
    target = place.is_a?(String) && place !~ /\A[u\d]/i ? nearest(place) : place
    return nil if target.nil? || !go2(target)
    yield
  ensure
    go2(here) if here && Room.current&.id != here
  end
end
